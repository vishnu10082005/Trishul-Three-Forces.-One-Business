@page "/"
@page "/dashboard"
@inject IDashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Dashboard — Trishul</PageTitle>

<!-- Page Header & Banner -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold">Dashboard</h1>
        <p class="text-muted mb-0">Overview of quotations, invoices, payments, and customer accounts.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="customers" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <line x1="19" y1="8" x2="19" y2="14"></line>
                <line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
            <span>Manage Customers</span>
        </a>
    </div>
</div>

<!-- Mock Data Disclaimer Banner -->
<div class="trishul-alert trishul-alert-warning mb-4">
    <div class="d-flex align-items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning flex-shrink-0">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>
            <strong>Sprint 1 UI Preview:</strong> Dashboard statistics below are loaded via <code>IDashboardService</code> (mock implementation). They are separated from UI logic and will be bound to the MongoDB backend in Sprint 2.
        </span>
    </div>
    <span class="badge badge-status mock-badge ms-2">Mock Data</span>
</div>

@if (summary == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading dashboard...</span>
        </div>
    </div>
}
else
{
    <!-- 4 Summary Metric Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Quotations -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-box blue">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Total Quotations</div>
                    <div class="metric-value">@summary.TotalQuotationsCount</div>
                    <div class="metric-sub">Value: ₹@summary.TotalQuotationsAmount.ToString("N0")</div>
                </div>
            </div>
        </div>

        <!-- Total Invoices -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-box purple">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Total Invoices</div>
                    <div class="metric-value">@summary.TotalInvoicesCount</div>
                    <div class="metric-sub">Value: ₹@summary.TotalInvoicesAmount.ToString("N0")</div>
                </div>
            </div>
        </div>

        <!-- Paid Amount -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-box green">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Paid Amount</div>
                    <div class="metric-value text-success">₹@summary.PaidAmount.ToString("N0")</div>
                    <div class="metric-sub">Received payments</div>
                </div>
            </div>
        </div>

        <!-- Pending Amount -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-box amber">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Pending Amount</div>
                    <div class="metric-value text-warning">₹@summary.PendingAmount.ToString("N0")</div>
                    <div class="metric-sub">Outstanding dues</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity / Invoices Section -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-8">
            <div class="trishul-card">
                <div class="trishul-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="h5 mb-0 fw-semibold">Recent Billing Activity</h2>
                        <span class="badge badge-status mock-badge">Mock Feed</span>
                    </div>
                    <span class="text-muted small">Latest 5 items</span>
                </div>
                <div class="trishul-card-body p-0">
                    <div class="trishul-table-container">
                        <table class="trishul-table">
                            <thead>
                                <tr>
                                    <th>Ref #</th>
                                    <th>Type</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentActivities != null)
                                {
                                    @foreach (var item in recentActivities)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.ReferenceNumber</td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@item.ActivityType</span>
                                            </td>
                                            <td>@item.CustomerName</td>
                                            <td class="text-muted">@item.Date.ToString("dd MMM yyyy")</td>
                                            <td class="fw-medium">₹@item.Amount.ToString("N0")</td>
                                            <td>
                                                <span class="badge-status @item.Status.ToLowerInvariant()">
                                                    @item.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Status & System Architecture Info -->
        <div class="col-12 col-lg-4">
            <div class="trishul-card h-100">
                <div class="trishul-card-header">
                    <h2 class="h5 mb-0 fw-semibold">Sprint Status</h2>
                    <span class="badge bg-primary">Phase 1/7</span>
                </div>
                <div class="trishul-card-body">
                    <div class="mb-3">
                        <div class="small fw-semibold text-muted text-uppercase mb-1">Architecture</div>
                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border mb-2">
                            <span class="small fw-medium">Frontend UI:</span>
                            <span class="small badge bg-success">Blazor Server (.NET 10)</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border mb-2">
                            <span class="small fw-medium">Backend API:</span>
                            <span class="small badge bg-success">Trishul.Api (:5185)</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border">
                            <span class="small fw-medium">Database:</span>
                            <span class="small badge bg-success">MongoDB Atlas (TrishulDb)</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="small fw-semibold text-muted text-uppercase mb-2">Quick Shortcuts</div>
                        <div class="d-grid gap-2">
                            <a href="customers" class="btn btn-outline-secondary btn-sm text-start d-flex justify-content-between align-items-center">
                                <span>👥 Customer Management</span>
                                <span>&rarr;</span>
                            </a>
                            <a href="quotations" class="btn btn-outline-secondary btn-sm text-start d-flex justify-content-between align-items-center">
                                <span>📄 Quotations Preview</span>
                                <span>&rarr;</span>
                            </a>
                            <a href="invoices" class="btn btn-outline-secondary btn-sm text-start d-flex justify-content-between align-items-center">
                                <span>💳 Invoices Preview</span>
                                <span>&rarr;</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardSummary? summary;
    private IReadOnlyList<RecentActivityItem>? recentActivities;

    protected override async Task OnInitializedAsync()
    {
        summary = await DashboardService.GetSummaryAsync();
        recentActivities = await DashboardService.GetRecentActivitiesAsync();
    }
}
