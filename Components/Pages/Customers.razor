@page "/customers"
@inject ICustomerService CustomerService

<PageTitle>Customers — Trishul</PageTitle>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold">Customer Management</h1>
        <p class="text-muted mb-0">Manage customer accounts, contact details, and billing addresses in MongoDB Atlas.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-primary d-inline-flex align-items-center gap-2" @onclick="OpenAddCustomerModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add Customer</span>
        </button>
    </div>
</div>

<!-- Feedback Message Banner -->
@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="trishul-alert @(isStatusError ? "trishul-alert-warning" : "trishul-alert-success") alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-center gap-2">
            @if (isStatusError)
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-danger flex-shrink-0">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success flex-shrink-0">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            }
            <span>@statusMessage</span>
        </div>
        <button type="button" class="btn-close" @onclick="() => statusMessage = null" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Controls -->
<div class="trishul-card mb-4">
    <div class="trishul-card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text"
                           class="form-control border-start-0 ps-0"
                           placeholder="Search by name, phone, email, or address..."
                           value="@searchTerm"
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Clear Search">
                            &times;
                        </button>
                    }
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-7 d-flex justify-content-md-end align-items-center gap-2">
                <span class="text-muted small">
                    @if (customers != null)
                    {
                        <span>Showing <strong>@customers.Count</strong> customer@(customers.Count == 1 ? "" : "s")</span>
                    }
                </span>
                <span class="badge badge-status paid">
                    <span class="db-status-dot connected d-inline-block me-1"></span>
                    MongoDB Atlas
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Customer Table or Empty / Error State -->
<div class="trishul-card">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center p-5">
            <div class="spinner-border text-primary me-2" role="status"></div>
            <span class="text-muted">Fetching customer records from MongoDB...</span>
        </div>
    }
    else if (loadFailed)
    {
        <div class="empty-state">
            <div class="empty-state-icon text-danger" style="background-color: #fee2e2;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <h3 class="empty-state-title text-danger">Backend API Unavailable</h3>
            <p class="empty-state-desc">
                Could not connect to Trishul.Api on <code>http://localhost:5185</code>. Please ensure the backend is running.
            </p>
            <button class="btn btn-primary" @onclick="LoadCustomersAsync">
                Retry Connection
            </button>
        </div>
    }
    else if (customers == null || customers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <h3 class="empty-state-title">No matching customers</h3>
                <p class="empty-state-desc">
                    No customers in MongoDB matching "<strong>@searchTerm</strong>". Try refining your search query or clear the filter.
                </p>
                <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                    Clear Search
                </button>
            }
            else
            {
                <h3 class="empty-state-title">No customers in database yet</h3>
                <p class="empty-state-desc">
                    The MongoDB collection <code>Customers</code> is ready. Add your first customer to get started.
                </p>
                <button class="btn btn-primary" @onclick="OpenAddCustomerModal">
                    Add First Customer
                </button>
            }
        </div>
    }
    else
    {
        <div class="trishul-table-container">
            <table class="trishul-table">
                <thead>
                    <tr>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Added Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in customers)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.8rem; flex-shrink: 0;">
                                        @(GetInitials(c.Name))
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@c.Name</div>
                                        <div class="text-muted" style="font-size: 0.7rem; font-family: monospace;">ID: @c.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="tel:@c.Phone" class="text-decoration-none text-dark">
                                    @c.Phone
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(c.Email))
                                {
                                    <a href="mailto:@c.Email" class="text-decoration-none">
                                        @c.Email
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-muted" style="max-width: 250px;">
                                <div class="text-truncate" title="@c.Address">
                                    @(string.IsNullOrWhiteSpace(c.Address) ? "—" : c.Address)
                                </div>
                            </td>
                            <td class="text-muted small">
                                @c.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Edit Customer" @onclick="() => OpenEditCustomerModal(c)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span class="ms-1 d-none d-lg-inline">Edit</span>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Delete Customer" @onclick="() => PromptDelete(c)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Add / Edit Customer Modal -->
@if (isModalOpen)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="modal-title mb-0 fw-bold">
                    @(isEditing ? "Edit Customer" : "Add New Customer")
                </h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
            </div>

            <EditForm Model="editingCustomer" OnValidSubmit="SaveCustomer">
                <DataAnnotationsValidator />

                <div class="modal-body-custom">
                    <!-- Live MongoDB Banner -->
                    <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 text-success">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span><strong>MongoDB Atlas:</strong> Customer record will be saved directly into collection <code>Customers</code> in <code>TrishulDb</code>.</span>
                    </div>

                    <!-- Customer Name -->
                    <div class="mb-3">
                        <label class="form-label" for="custName">Customer Name <span class="text-danger">*</span></label>
                        <InputText id="custName" class="form-control" placeholder="e.g. Acme Industrial Supplies" @bind-Value="editingCustomer.Name" />
                        <ValidationMessage For="() => editingCustomer.Name" class="validation-message" />
                    </div>

                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label class="form-label" for="custPhone">Phone Number <span class="text-danger">*</span></label>
                        <InputText id="custPhone" class="form-control" placeholder="e.g. +91 98450 12345" @bind-Value="editingCustomer.Phone" />
                        <ValidationMessage For="() => editingCustomer.Phone" class="validation-message" />
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label class="form-label" for="custEmail">Email Address</label>
                        <InputText id="custEmail" class="form-control" placeholder="e.g. accounts@acme.com" @bind-Value="editingCustomer.Email" />
                        <ValidationMessage For="() => editingCustomer.Email" class="validation-message" />
                    </div>

                    <!-- GSTIN (Optional) -->
                    <div class="mb-3">
                        <label class="form-label" for="custGstin">GSTIN (Optional)</label>
                        <InputText id="custGstin" class="form-control" placeholder="e.g. 29ABCDE1234F1Z5" @bind-Value="editingCustomer.Gstin" />
                        <ValidationMessage For="() => editingCustomer.Gstin" class="validation-message" />
                    </div>

                    <!-- Address -->
                    <div class="mb-3">
                        <label class="form-label" for="custAddress">Billing / Office Address</label>
                        <InputTextArea id="custAddress" class="form-control" rows="3" placeholder="Enter complete address, state, and pin code..." @bind-Value="editingCustomer.Address" />
                        <ValidationMessage For="() => editingCustomer.Address" class="validation-message" />
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Saving to MongoDB...</span>
                        }
                        else
                        {
                            <span>@(isEditing ? "Save Changes" : "Create Customer")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Delete Confirmation Dialog -->
@if (customerToDelete != null)
{
    <div class="modal-backdrop-custom" @onclick="CancelDelete">
        <div class="modal-dialog-custom" style="max-width: 440px;" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="modal-title mb-0 fw-bold text-danger">Confirm Delete</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete"></button>
            </div>
            <div class="modal-body-custom">
                <p class="mb-2">Are you sure you want to delete customer <strong>@customerToDelete.Name</strong>?</p>
                <p class="text-muted small mb-0">This will permanently remove the record from MongoDB Atlas database.</p>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete Customer</button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<Customer>? customers;
    private bool isLoading = true;
    private bool loadFailed = false;
    private string searchTerm = string.Empty;

    // Modal state
    private bool isModalOpen = false;
    private bool isEditing = false;
    private bool isSubmitting = false;
    private Customer editingCustomer = new();

    // Delete state
    private Customer? customerToDelete;

    // Toast/Alert status
    private string? statusMessage;
    private bool isStatusError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        isLoading = true;
        loadFailed = false;
        try
        {
            customers = await CustomerService.GetCustomersAsync(searchTerm);
        }
        catch (Exception ex)
        {
            loadFailed = true;
            statusMessage = $"API connection failure: {ex.Message}";
            isStatusError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadCustomersAsync();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        await LoadCustomersAsync();
    }

    private void OpenAddCustomerModal()
    {
        isEditing = false;
        editingCustomer = new Customer();
        isModalOpen = true;
    }

    private void OpenEditCustomerModal(Customer customer)
    {
        isEditing = true;
        editingCustomer = customer.Clone();
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveCustomer()
    {
        isSubmitting = true;
        try
        {
            var saved = await CustomerService.SaveCustomerAsync(editingCustomer);
            statusMessage = isEditing
                ? $"Customer \"{saved.Name}\" was updated successfully in MongoDB Atlas."
                : $"Customer \"{saved.Name}\" was created successfully in MongoDB Atlas.";
            isStatusError = false;
            isModalOpen = false;
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving customer: {ex.Message}";
            isStatusError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void PromptDelete(Customer customer)
    {
        customerToDelete = customer;
    }

    private void CancelDelete()
    {
        customerToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (customerToDelete != null)
        {
            var name = customerToDelete.Name;
            var id = customerToDelete.Id;
            if (!string.IsNullOrEmpty(id))
            {
                try
                {
                    var success = await CustomerService.DeleteCustomerAsync(id);
                    if (success)
                    {
                        statusMessage = $"Customer \"{name}\" was deleted from MongoDB Atlas.";
                        isStatusError = false;
                    }
                    else
                    {
                        statusMessage = $"Customer \"{name}\" was not found in the database.";
                        isStatusError = true;
                    }
                }
                catch (Exception ex)
                {
                    statusMessage = $"Error deleting customer: {ex.Message}";
                    isStatusError = true;
                }
            }
            customerToDelete = null;
            await LoadCustomersAsync();
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "CU";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpperInvariant();
    }
}
