@page "/payments"

<PageTitle>Payments — Trishul</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold">Payments</h1>
        <p class="text-muted mb-0">Record customer receipts, reconcile invoices, and track outstanding balances.</p>
    </div>
</div>

<div class="trishul-card">
    <div class="trishul-card-body text-center py-5">
        <div class="empty-state-icon text-primary bg-primary bg-opacity-10 mb-3" style="width: 4rem; height: 4rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
        </div>
        <h3 class="h5 fw-bold mb-2">Payments Module Planned for Future Sprint</h3>
        <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
            Payment recording and settlement logs are scheduled for subsequent development phases after invoice processing is established.
        </p>

        <div class="row g-3 justify-content-center text-start mx-auto mb-4" style="max-width: 600px;">
            <div class="col-12 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <div class="fw-semibold text-dark mb-1">💳 Upcoming Features</div>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Record partial & full payments</li>
                        <li>Cash, UPI, NEFT, and Cheque tracking</li>
                        <li>Payment receipt generation</li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <div class="fw-semibold text-dark mb-1">📊 Balance Tracking</div>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Customer balance ledger</li>
                        <li>Overdue alerts and reminders</li>
                        <li>Real-time dashboard revenue updates</li>
                    </ul>
                </div>
            </div>
        </div>

        <a href="" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>
</div>
