@page "/admin/customer-accounts"
@inject IAdminAccountService AdminAccountService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Customer Accounts — Trishul Admin</PageTitle>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold">Customer Portal Accounts</h1>
        <p class="text-muted mb-0">Manage customer login identities, initial credentials, and workspace access status.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-primary d-inline-flex align-items-center gap-2" @onclick="OpenAddModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <line x1="19" y1="8" x2="19" y2="14"></line>
                <line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
            <span>Create Customer Account</span>
        </button>
    </div>
</div>

<!-- Alert for newly created temporary password -->
@if (!string.IsNullOrEmpty(newlyCreatedPasswordNotice))
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm border-warning" role="alert">
        <div class="d-flex align-items-start gap-3">
            <div class="bg-warning text-dark rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                🔑
            </div>
            <div class="flex-grow-1">
                <h6 class="alert-heading fw-bold mb-1">Customer Account Created Successfully!</h6>
                <p class="mb-2 small">
                    Provide these initial login credentials securely to <strong>@newlyCreatedAccountName</strong>.
                    Per security requirements, plain-text passwords are never displayed again once dismissed.
                </p>
                <div class="d-inline-flex align-items-center gap-3 bg-white p-2 px-3 rounded border">
                    <span class="small text-muted">Temporary Password:</span>
                    <code class="fw-bold fs-6 text-primary">@newlyCreatedPasswordNotice</code>
                </div>
            </div>
        </div>
        <button type="button" class="btn-close" @onclick="() => newlyCreatedPasswordNotice = null" aria-label="Close"></button>
    </div>
}

<!-- General Status Alert -->
@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="trishul-alert @(isStatusError ? "trishul-alert-warning" : "trishul-alert-success") alert-dismissible fade show" role="alert">
        <span>@statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => statusMessage = null" aria-label="Close"></button>
    </div>
}

<!-- Filter & Search Toolbar -->
<div class="trishul-card mb-4">
    <div class="trishul-card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text"
                           class="form-control border-start-0 ps-0"
                           placeholder="Filter by customer name, email, or mobile..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => searchTerm = string.Empty">
                            &times;
                        </button>
                    }
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-7 d-flex justify-content-md-end align-items-center gap-2">
                <span class="text-muted small">
                    Total Customer Accounts: <strong>@(accounts?.Count ?? 0)</strong>
                </span>
                <span class="badge bg-primary">Admin Access Only</span>
            </div>
        </div>
    </div>
</div>

<!-- Accounts Table -->
<div class="trishul-card">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center p-5">
            <div class="spinner-border text-primary me-2" role="status"></div>
            <span class="text-muted">Loading customer accounts from MongoDB...</span>
        </div>
    }
    else if (accounts == null || filteredAccounts.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                </svg>
            </div>
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <h3 class="empty-state-title">No matching accounts found</h3>
                <p class="empty-state-desc">Try clearing your search term or checking for typos.</p>
                <button class="btn btn-outline-secondary" @onclick="() => searchTerm = string.Empty">Clear Search</button>
            }
            else
            {
                <h3 class="empty-state-title">No customer login accounts yet</h3>
                <p class="empty-state-desc">Create customer login credentials so your clients can access their quotation and invoice portal.</p>
                <button class="btn btn-primary" @onclick="OpenAddModal">Create First Customer Account</button>
            }
        </div>
    }
    else
    {
        <div class="trishul-table-container">
            <table class="trishul-table">
                <thead>
                    <tr>
                        <th>Customer / Business Name</th>
                        <th>Email</th>
                        <th>Mobile Number</th>
                        <th>Access Status</th>
                        <th>Security Status</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in filteredAccounts)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.8rem; flex-shrink: 0;">
                                        @(GetInitials(acc.FullName))
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@acc.FullName</div>
                                        <div class="text-muted" style="font-size: 0.7rem; font-family: monospace;">ID: @acc.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(acc.Email) ? "—" : acc.Email)
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(acc.Phone) ? "—" : acc.Phone)
                            </td>
                            <td>
                                @if (acc.IsActive)
                                {
                                    <span class="badge-status paid">
                                        <span class="db-status-dot connected d-inline-block me-1"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 small rounded-pill">
                                        Deactivated
                                    </span>
                                }
                            </td>
                            <td>
                                @if (acc.MustChangePassword)
                                {
                                    <span class="badge bg-warning bg-opacity-20 text-dark border border-warning px-2 py-1 small rounded-pill" title="Customer must set new password upon next sign-in">
                                        ⚠️ Temp Password
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1 small rounded-pill">
                                        Password Set
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">
                                @acc.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Edit Account" @onclick="() => OpenEditModal(acc)">
                                        Edit
                                    </button>
                                    <button class="btn btn-outline-secondary" title="Reset Password" @onclick="() => OpenResetPasswordModal(acc)">
                                        Reset Pwd
                                    </button>
                                    @if (acc.IsActive)
                                    {
                                        <button class="btn btn-outline-danger" title="Deactivate Access" @onclick="() => ToggleStatus(acc, false)">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-success" title="Activate Access" @onclick="() => ToggleStatus(acc, true)">
                                            Activate
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal: Create Customer Account -->
@if (isAddModalOpen)
{
    <div class="modal-backdrop-custom" @onclick="() => isAddModalOpen = false">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="modal-title fw-bold">Create Customer Login Account</h5>
                <button type="button" class="btn-close" @onclick="() => isAddModalOpen = false"></button>
            </div>
            <div class="modal-body-custom">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3">@modalError</div>
                }

                <div class="mb-3">
                    <label class="form-label">Customer / Business Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Apex Industrial Solutions" @bind="newAccountModel.FullName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" placeholder="e.g. procurement@apex.com" @bind="newAccountModel.Email" />
                    <div class="form-text small">Used by customer for portal sign-in.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mobile Phone Number</label>
                    <input type="text" class="form-control" placeholder="e.g. +91 98450 12345" @bind="newAccountModel.Phone" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Initial Password (Optional)</label>
                    <input type="text" class="form-control" placeholder="Leave empty to auto-generate a secure temporary password" @bind="newAccountModel.InitialPassword" />
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="chkMustChange" @bind="newAccountModel.RequirePasswordChange" />
                    <label class="form-check-label small" for="chkMustChange">
                        Require customer to change password at first login
                    </label>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => isAddModalOpen = false">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveNewCustomerAccount" disabled="@isActionSubmitting">
                    @(isActionSubmitting ? "Creating Account..." : "Create Account")
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: Edit Customer Account Details -->
@if (editingAccount != null)
{
    <div class="modal-backdrop-custom" @onclick="() => editingAccount = null">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="modal-title fw-bold">Edit Customer Account</h5>
                <button type="button" class="btn-close" @onclick="() => editingAccount = null"></button>
            </div>
            <div class="modal-body-custom">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3">@modalError</div>
                }

                <div class="mb-3">
                    <label class="form-label">Customer / Business Name</label>
                    <input type="text" class="form-control" @bind="editFullName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" class="form-control" @bind="editEmail" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mobile Phone</label>
                    <input type="text" class="form-control" @bind="editPhone" />
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => editingAccount = null">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveEditCustomerAccount" disabled="@isActionSubmitting">
                    @(isActionSubmitting ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: Reset Password -->
@if (resetAccountTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="() => resetAccountTarget = null">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="modal-title fw-bold">Reset Password for @resetAccountTarget.FullName</h5>
                <button type="button" class="btn-close" @onclick="() => resetAccountTarget = null"></button>
            </div>
            <div class="modal-body-custom">
                <p class="small text-muted mb-3">
                    Assign a new temporary password or leave blank to automatically generate one.
                </p>

                <div class="mb-3">
                    <label class="form-label">New Password (Optional)</label>
                    <input type="text" class="form-control" placeholder="Leave empty to auto-generate" @bind="resetCustomPassword" />
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkResetChange" @bind="resetMustChange" />
                    <label class="form-check-label small" for="chkResetChange">
                        Require password change at next sign-in
                    </label>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => resetAccountTarget = null">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmResetPassword" disabled="@isActionSubmitting">
                    @(isActionSubmitting ? "Resetting..." : "Reset Password")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<CustomerAccountItem>? accounts;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string? statusMessage;
    private bool isStatusError = false;

    // Password notice
    private string? newlyCreatedPasswordNotice;
    private string? newlyCreatedAccountName;

    // Modals
    private bool isAddModalOpen = false;
    private bool isActionSubmitting = false;
    private string? modalError;
    private CreateCustomerAccountModel newAccountModel = new();

    // Edit modal
    private CustomerAccountItem? editingAccount;
    private string editFullName = string.Empty;
    private string editEmail = string.Empty;
    private string editPhone = string.Empty;

    // Reset password modal
    private CustomerAccountItem? resetAccountTarget;
    private string? resetCustomPassword;
    private bool resetMustChange = true;

    private IReadOnlyList<CustomerAccountItem> filteredAccounts
    {
        get
        {
            if (accounts == null) return Array.Empty<CustomerAccountItem>();
            if (string.IsNullOrWhiteSpace(searchTerm)) return accounts;

            var term = searchTerm.Trim();
            return accounts.Where(a =>
                a.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.Email.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.Phone.Contains(term, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentUserSessionAsync();
        if (session == null || !session.IsAdmin)
        {
            Navigation.NavigateTo("login");
            return;
        }

        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        isLoading = true;
        try
        {
            accounts = await AdminAccountService.GetCustomerAccountsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load accounts: {ex.Message}";
            isStatusError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        newAccountModel = new CreateCustomerAccountModel { RequirePasswordChange = true };
        modalError = null;
        isAddModalOpen = true;
    }

    private async Task SaveNewCustomerAccount()
    {
        modalError = null;
        if (string.IsNullOrWhiteSpace(newAccountModel.FullName))
        {
            modalError = "Please enter Customer / Business Name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newAccountModel.Email) && string.IsNullOrWhiteSpace(newAccountModel.Phone))
        {
            modalError = "Please enter at least an email address or mobile number.";
            return;
        }

        isActionSubmitting = true;
        try
        {
            var result = await AdminAccountService.CreateCustomerAccountAsync(newAccountModel);
            if (!result.Success)
            {
                modalError = result.Message;
                return;
            }

            isAddModalOpen = false;
            newlyCreatedAccountName = newAccountModel.FullName;
            newlyCreatedPasswordNotice = result.GeneratedPassword;
            statusMessage = $"Customer account for \"{newAccountModel.FullName}\" created successfully in MongoDB.";
            isStatusError = false;

            await LoadAccountsAsync();
        }
        finally
        {
            isActionSubmitting = false;
        }
    }

    private void OpenEditModal(CustomerAccountItem acc)
    {
        editingAccount = acc;
        editFullName = acc.FullName;
        editEmail = acc.Email;
        editPhone = acc.Phone;
        modalError = null;
    }

    private async Task SaveEditCustomerAccount()
    {
        if (editingAccount == null) return;
        modalError = null;

        isActionSubmitting = true;
        try
        {
            var ok = await AdminAccountService.UpdateCustomerAccountAsync(editingAccount.Id, editFullName, editEmail, editPhone);
            if (ok)
            {
                statusMessage = $"Account for \"{editFullName}\" updated successfully.";
                isStatusError = false;
                editingAccount = null;
                await LoadAccountsAsync();
            }
            else
            {
                modalError = "Failed to update account. Please check for duplicate email or phone.";
            }
        }
        finally
        {
            isActionSubmitting = false;
        }
    }

    private async Task ToggleStatus(CustomerAccountItem acc, bool newStatus)
    {
        var ok = await AdminAccountService.ToggleAccountStatusAsync(acc.Id, newStatus);
        if (ok)
        {
            statusMessage = newStatus ? $"Account \"{acc.FullName}\" activated." : $"Account \"{acc.FullName}\" deactivated.";
            isStatusError = false;
            await LoadAccountsAsync();
        }
        else
        {
            statusMessage = "Failed to change account status.";
            isStatusError = true;
        }
    }

    private void OpenResetPasswordModal(CustomerAccountItem acc)
    {
        resetAccountTarget = acc;
        resetCustomPassword = null;
        resetMustChange = true;
    }

    private async Task ConfirmResetPassword()
    {
        if (resetAccountTarget == null) return;
        isActionSubmitting = true;
        try
        {
            var genPassword = await AdminAccountService.ResetCustomerPasswordAsync(resetAccountTarget.Id, resetCustomPassword, resetMustChange);
            newlyCreatedAccountName = resetAccountTarget.FullName;
            newlyCreatedPasswordNotice = genPassword;
            statusMessage = $"Password for \"{resetAccountTarget.FullName}\" has been reset.";
            isStatusError = false;
            resetAccountTarget = null;
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Reset password error: {ex.Message}";
            isStatusError = true;
        }
        finally
        {
            isActionSubmitting = false;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "CU";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpperInvariant();
    }
}
