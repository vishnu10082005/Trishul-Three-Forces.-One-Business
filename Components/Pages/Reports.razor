@page "/reports"

<PageTitle>Reports — Trishul</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold">Reports & Analytics</h1>
        <p class="text-muted mb-0">Business performance metrics, sales summaries, and tax reports.</p>
    </div>
</div>

<div class="trishul-card">
    <div class="trishul-card-body text-center py-5">
        <div class="empty-state-icon text-primary bg-primary bg-opacity-10 mb-3" style="width: 4rem; height: 4rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
        </div>
        <h3 class="h5 fw-bold mb-2">Reports Module Planned for Future Sprint</h3>
        <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
            Comprehensive analytics and exportable statements will be introduced once quotation and invoice records are actively populated.
        </p>

        <div class="row g-3 justify-content-center text-start mx-auto mb-4" style="max-width: 600px;">
            <div class="col-12 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <div class="fw-semibold text-dark mb-1">📈 Planned Reports</div>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Monthly sales & revenue graphs</li>
                        <li>Customer receivables ageing report</li>
                        <li>Quotation conversion rate metrics</li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <div class="fw-semibold text-dark mb-1">📥 Export Formats</div>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Excel / CSV export</li>
                        <li>PDF summary statements</li>
                        <li>Tax / GST filing summaries</li>
                    </ul>
                </div>
            </div>
        </div>

        <a href="" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>
</div>
